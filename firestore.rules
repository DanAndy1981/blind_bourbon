rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function gameData(code) {
      return get(/databases/$(database)/documents/games/$(code)).data;
    }

    function isHost(code) {
      return signedIn() && gameData(code).hostUid == request.auth.uid;
    }

    // During initial game creation, the parent game and all child documents
    // are written in one atomic batch. getAfter() lets the child-create rules
    // validate the parent game as it will exist when that batch commits.
    function gameDataAfter(code) {
      return getAfter(/databases/$(database)/documents/games/$(code)).data;
    }

    function isHostAfter(code) {
      return signedIn() && gameDataAfter(code).hostUid == request.auth.uid;
    }

    function playerData(code, playerId) {
      return get(/databases/$(database)/documents/games/$(code)/players/$(playerId)).data;
    }

    function ownsPlayer(code, playerId) {
      return signedIn() && playerData(code, playerId).claimedBy == request.auth.uid;
    }

    function validScoreboardProgress() {
      return request.resource.data.tastingProgress is number
        && request.resource.data.tastingProgress >= 0
        && request.resource.data.tastingProgress <= 1
        && request.resource.data.tastingComplete is bool
        && request.resource.data.tastingCompletedLetters is list
        && request.resource.data.tastingCompletedLetters.size() <= 10
        && request.resource.data.tastingCompletedLetters.hasOnly(['A','B','C','D','E','F','G','H','I','J'])
        && validTastingNotes(request.resource.data.tastingNotesByLetter)
        && request.resource.data.higherLowerProgress is number
        && request.resource.data.higherLowerProgress >= 0
        && request.resource.data.higherLowerProgress <= 1
        && request.resource.data.higherLowerComplete is bool
        && request.resource.data.higherLowerCompletedLetters is list
        && request.resource.data.higherLowerCompletedLetters.size() <= 10
        && request.resource.data.higherLowerCompletedLetters.hasOnly(['A','B','C','D','E','F','G','H','I','J']);
    }

    function validTastingNotes(notes) {
      return notes is map
        && notes.size() <= 10
        && notes.keys().hasOnly(['A','B','C','D','E','F','G','H','I','J'])
        && (!notes.keys().hasAny(['A']) || (notes.A is string && notes.A.size() <= 280))
        && (!notes.keys().hasAny(['B']) || (notes.B is string && notes.B.size() <= 280))
        && (!notes.keys().hasAny(['C']) || (notes.C is string && notes.C.size() <= 280))
        && (!notes.keys().hasAny(['D']) || (notes.D is string && notes.D.size() <= 280))
        && (!notes.keys().hasAny(['E']) || (notes.E is string && notes.E.size() <= 280))
        && (!notes.keys().hasAny(['F']) || (notes.F is string && notes.F.size() <= 280))
        && (!notes.keys().hasAny(['G']) || (notes.G is string && notes.G.size() <= 280))
        && (!notes.keys().hasAny(['H']) || (notes.H is string && notes.H.size() <= 280))
        && (!notes.keys().hasAny(['I']) || (notes.I is string && notes.I.size() <= 280))
        && (!notes.keys().hasAny(['J']) || (notes.J is string && notes.J.size() <= 280));
    }

    function validEasterEggCompletion() {
      return request.resource.data.easterEggCompleted == true
        && request.resource.data.easterEggCompletedStage is string
        && request.resource.data.easterEggCompletedStage in ['tasting', 'higherLower', 'reveal'];
    }

    match /games/{code} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if isHost(code);

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if isHostAfter(code);
        allow delete: if isHost(code);
        allow update: if isHost(code) || (
          signedIn()
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimedAt'])
              && (
                (resource.data.claimedBy == null && request.resource.data.claimedBy == request.auth.uid)
                || (resource.data.claimedBy == request.auth.uid && request.resource.data.claimedBy == null)
                || (resource.data.claimedBy == request.auth.uid && request.resource.data.claimedBy == request.auth.uid)
              )
            )
            || (
              resource.data.claimedBy == request.auth.uid
              && request.resource.data.claimedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'tastingProgress',
                'tastingComplete',
                'tastingCompletedLetters',
                'tastingNotesByLetter',
                'higherLowerProgress',
                'higherLowerComplete',
                'higherLowerCompletedLetters'
              ])
              && validScoreboardProgress()
            )
            || (
              resource.data.claimedBy == request.auth.uid
              && request.resource.data.claimedBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'easterEggCompleted',
                'easterEggCompletedStage'
              ])
              && validEasterEggCompletion()
            )
          )
        );
      }

      match /bottles/{letter} {
        allow read: if signedIn();
        allow create: if isHostAfter(code);
        allow update, delete: if isHost(code);
      }

      match /bottleDetails/{letter} {
        allow read: if isHost(code)
          || get(/databases/$(database)/documents/games/$(code)/bottles/$(letter)).data.revealed == true;
        allow create: if isHostAfter(code);
        allow update, delete: if isHost(code);
      }

      match /responses/{responseId} {
        allow read: if isHost(code)
          || gameData(code).phase == 'reveal'
          || gameData(code).phase == 'final'
          || (resource.data.playerId != null && ownsPlayer(code, resource.data.playerId));

        allow create, update: if signedIn()
          && request.resource.data.playerId is string
          && request.resource.data.bottleLetter is string
          && responseId == request.resource.data.playerId + '_' + request.resource.data.bottleLetter
          && ownsPlayer(code, request.resource.data.playerId);

        allow delete: if isHost(code)
          || (resource.data.playerId != null && ownsPlayer(code, resource.data.playerId));
      }

      match /picks/{playerId} {
        allow read: if isHost(code)
          || gameData(code).phase == 'reveal'
          || gameData(code).phase == 'final'
          || ownsPlayer(code, playerId);

        allow create, update: if ownsPlayer(code, playerId)
          && request.resource.data.playerId == playerId;

        allow delete: if isHost(code) || ownsPlayer(code, playerId);
      }
    }
  }
}
